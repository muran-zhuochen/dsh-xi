{
  "name": "dsh-power",
  "version": "0.1.6",
  "private": true,
  "description": "会话头部那排图标里的电源开关：最小化、重启、退出应用",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "client.js",
    "scripts",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
